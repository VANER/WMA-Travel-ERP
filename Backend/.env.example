WMA_ENVIRONMENT=development
WMA_LOG_LEVEL=INFO
WMA_DATABASE_URL=postgresql+psycopg://usuario_local:senha_local@localhost:5432/wma_development
WMA_DATABASE_POOL_SIZE=5
WMA_DATABASE_MAX_OVERFLOW=10
WMA_DATABASE_POOL_TIMEOUT=30
WMA_DATABASE_POOL_RECYCLE=1800
WMA_DATABASE_CONNECT_TIMEOUT=5
WMA_TOKEN_SIGNING_KEY=substitua-esta-chave-em-ambiente-local
WMA_TOKEN_ISSUER=wma-travel-erp
WMA_TOKEN_AUDIENCE=wma-travel-erp-api
WMA_ACCESS_TOKEN_TTL_MINUTES=15
WMA_REFRESH_TOKEN_TTL_DAYS=7
WMA_SMTP_HOST=smtp.titan.email
WMA_SMTP_PORT=465
WMA_SMTP_USERNAME=usuario@example.invalid
# Defina WMA_SMTP_PASSWORD somente no arquivo .env local não versionado.
WMA_SMTP_SENDER=usuario@example.invalid
WMA_RECOVERY_URL=https://example.invalid/redefinir-senha
