{
  // ==========================================================
  // WMA Travel ERP
  // Configuração Corporativa do Markdownlint
  // Versão: 1.0.0
  // ==========================================================

  // Apenas um título H1 por documento
  "MD025": true,

  // Não permitir títulos duplicados no mesmo nível
  "MD024": {
    "siblings_only": true
  },

  // Permitir apenas uma linha em branco consecutiva
  "MD012": {
    "maximum": 1
  },

  // Exigir linguagem em blocos de código
  "MD040": true,

  // Arquivos devem terminar com uma única quebra de linha
  "MD047": true,

  // Não permitir URLs sem formatação
  "MD034": true,

  // Marcador de listas com hífen (-)
  "MD004": {
    "style": "dash"
  },

  // Recuo de listas
  "MD007": {
    "indent": 2
  },

  // Linhas em branco ao redor dos títulos
  "MD022": true,

  // Linhas em branco ao redor das listas
  "MD032": true,

  // Tabelas com pipes nas extremidades
  "MD055": true,

  // Espaço interno em tabelas
  "MD056": true,

  // Limite de tamanho das linhas
  "MD013": {
    "line_length": 120,
    "heading_line_length": 120,
    "code_blocks": false,
    "tables": false,
    "headings": false,
    "strict": false
  },

  // Permitir HTML quando necessário
  "MD033": false,

  // Permitir texto em negrito como subtítulo
  "MD036": false,

  // Permitir numeração repetida em listas ordenadas
  "MD029": {
    "style": "ordered"
  },

  // Permitir números duplicados em cabeçalhos
  "MD001": true,

  // Exigir um espaço após o símbolo #
  "MD018": true,

  // Não permitir múltiplos espaços após #
  "MD019": true,

  // Exigir cabeçalhos cercados por linhas em branco
  "MD022": true,

  // Exigir linhas em branco antes e depois de blocos de código
  "MD031": true,

  // Exigir linhas em branco antes e depois de citações
  "MD028": true
}
