{
  // ==========================================================
  // WMA Travel ERP
  // Configuração Corporativa do Markdownlint
  // Compatível com:
  // - markdownlint (David Anson)
  // - markdownlint-cli
  // - GitHub Flavored Markdown
  // ==========================================================

  // ----------------------------------------------------------
  // Títulos
  // ----------------------------------------------------------

  "MD001": true,
  "MD002": false,

  "MD003": {
    "style": "atx"
  },

  "MD018": true,
  "MD019": true,
  "MD022": true,
  "MD023": true,

  "MD024": {
    "siblings_only": true
  },

  "MD025": true,

  // Permite títulos terminados com ":" e similares
  "MD026": false,

  // ----------------------------------------------------------
  // Listas
  // ----------------------------------------------------------

  "MD004": {
    "style": "dash"
  },

  "MD005": true,
  "MD006": true,

  "MD007": {
    "indent": 2
  },

  "MD029": {
    "style": "ordered"
  },

  "MD030": true,
  "MD032": true,

  // ----------------------------------------------------------
  // Espaçamento
  // ----------------------------------------------------------

  "MD009": true,

  "MD010": {
    "code_blocks": false
  },

  "MD012": {
    "maximum": 1
  },

  "MD027": true,
  "MD028": true,
  "MD031": true,

  // ----------------------------------------------------------
  // Comprimento das linhas
  // ----------------------------------------------------------

  "MD013": {
    "line_length": 120,
    "heading_line_length": 120,
    "code_blocks": false,
    "tables": false,
    "headings": false,
    "strict": false
  },

  // ----------------------------------------------------------
  // HTML
  // ----------------------------------------------------------

  "MD033": false,

  // ----------------------------------------------------------
  // Links
  // ----------------------------------------------------------

  "MD034": true,
  "MD039": true,

  "MD051": true,
  "MD052": true,
  "MD053": true,
  "MD054": true,
  "MD059": true,

  // ----------------------------------------------------------
  // Blocos de código
  // ----------------------------------------------------------

  "MD036": false,
  "MD037": true,
  "MD038": true,
  "MD040": true,

  "MD046": {
    "style": "fenced"
  },

  "MD048": {
    "style": "backtick"
  },

  // ----------------------------------------------------------
  // Arquivos
  // ----------------------------------------------------------

  "MD041": false,
  "MD042": false,
  "MD045": true,
  "MD047": true,

  // ----------------------------------------------------------
  // Tabelas
  // ----------------------------------------------------------

  "MD055": {
    "style": "leading_and_trailing"
  },

  "MD056": true,

  "MD058": true,

  "MD060": {
    "style": "compact",
    "aligned_delimiter": false
  }
}
